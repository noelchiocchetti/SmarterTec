        </mxCell>
        <mxCell id="gETJYiWoEazGPCyRa00p-28" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=16;" value="&lt;span style=&quot;text-align: start; caret-color: rgb(51, 57, 68); color: rgb(51, 57, 68);&quot;&gt;&lt;font&gt;Zuverlässige Data Management Strategien für Mac-Systeme: von der Konzeption bis zur Umsetzung sicherer und getesteter Backup- und Wiederherstellungsstrategien nach Best Practices sorgen für eine stabile Arbeitsumgebung.&lt;/font&gt;&lt;/span&gt;" vertex="1">
          <mxGeometry height="170" width="216" x="102" y="340" as="geometry" />
        </mxCell>
        <mxCell id="gETJYiWoEazGPCyRa00p-29" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=16;" value="&lt;span style=&quot;text-align: start; caret-color: rgb(51, 57, 68); color: rgb(51, 57, 68);&quot;&gt;&lt;font&gt;Umfassender Schutz für Mac-Systeme: Prävention, Erkennung und Einordnung aktueller Bedrohungen wie Phishing, Ransomware oder Account-Hijacking – inklusive kompetenter Unterstützung im Ernstfall.&lt;/font&gt;&lt;/span&gt;" vertex="1">
          <mxGeometry height="170" width="216" x="522" y="130" as="geometry" />
        </mxCell>
        <mxCell id="gETJYiWoEazGPCyRa00p-30" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=16;" value="&lt;span style=&quot;text-align: start; caret-color: rgb(51, 57, 68); color: rgb(51, 57, 68);&quot;&gt;&lt;font&gt;Professionelle Beratung und technischer Support rund um Mac-Systeme – von Diagnose und Fehlerbehebung über macOS-Installation und Performance-Optimierung bis zur Integration in bestehende IT-Umgebungen.&lt;/font&gt;&lt;/span&gt;" vertex="1">
